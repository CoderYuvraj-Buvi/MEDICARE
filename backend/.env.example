# ==========================================
# MEDICARE BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port (assigned automatically by cloud hosts e.g. Render/Railway, defaults to 4000)
PORT=4000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/medicare?retryWrites=true&w=majority

# Cross-Origin URLs (production URLs of frontend and admin, without trailing slashes)
FRONTEND_URL=https://your-medicare-frontend.vercel.app
ADMIN_URL=https://your-medicare-admin.vercel.app

# Clerk Authentication Keys (From https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# JWT Secret for Doctor Authentication (Generate a random 32+ character string)
JWT_SECRET=your_super_secret_jwt_key_here

# Cloudinary Storage Credentials (From https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
